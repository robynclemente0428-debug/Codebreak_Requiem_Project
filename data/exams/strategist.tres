[resource]
script = ExtResource("1_spec")
rank_id = "strategist"
title = "STRATEGIST EXAM"
brief = Array[String](["Three samples, replayed from Checkpoint's quarantine logs: a swarm of leaked memory, armoured copied processes, then fast marker drones.", "The sandbox lends you counters: x and y. They keep their value between casts.", "Keep a count: one WHEN rule adds to x, and another acts on it (x >= N), or a buff grows with it, up to its limit (drag x onto its value). Count something about the fight, not just your casts.", "Your count must pay out at least 3 times.", "Clear every wave within 120 seconds.", "Graded on: your script's efficiency tier, time (par 80 s), damage taken (par 35%). Changing a counter (x += 1, x = 0) doesn't count as a block; reading one (x >= 3) does."])
required_condition = ""
required_condition_label = "count paid out"
required_variable = true
required_fires = 3
lends = Array[String](["variables"])
time_limit = 120.0
par_time = 80.0
par_damage = 0.35
fail_health = 0.25
wave_enemy = ExtResource("2_copy")
wave_sizes = Array[int]([10, 3, 4])
wave_enemies = Array[ExtResource("4_def")]([ExtResource("3_leak"), ExtResource("2_copy"), ExtResource("5_marker")])
wave_mods = Array[String](["", "", "rapid,swift"])
enemy_level = 4
spawn_radius = 8.5
arena_tiles = ExtResource("6_tiles")
wave_names = Array[String](["LEAKED MEMORY", "COPIED PROCESSES", "MARKER DRONES"])
wave_notes = Array[String](["A swarm. Weak alone, never alone.", "Few and armoured. Hit hard.", "Fast, and they hit hard. Don't let them settle."])
wave_tints = Array[Color]([Color(0.8, 0.3, 1, 1), Color(0.55, 0.9, 1, 1), Color(1, 0.22, 0.16, 1)])
