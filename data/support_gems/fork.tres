[resource]
script = ExtResource("1_def")
id = "fork_support"
display_name = "Fork Support"
allowed_tags = Array[int]([3])
program_knobs = Array[ExtResource("3_knob")]([SubResource("Knob_fork_count"), SubResource("Knob_fork_angle")])
mana_cost_increase = 0.2
description = "Shoot only. A bullet that hits its first enemy splits into 2 bullets, 30 degrees apart, that fly on from it for 60% of the damage. Forked bullets don't fork again. Adds the WHEN forked block, whose effects only change the forked bullets."
