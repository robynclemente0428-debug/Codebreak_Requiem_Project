[resource]
script = ExtResource("1_def")
id = "breakpoint_support"
display_name = "Breakpoint Support"
allowed_tags = Array[int]([3])
behavior_script = ExtResource("2_beh")
program_knobs = Array[ExtResource("3_knob")]([SubResource("Knob_bp_bonus"), SubResource("Knob_bp_hits"), SubResource("Knob_bp_burst")])
mana_cost_increase = 0.15
description = "Shoot only. Your first hit on an enemy sets a breakpoint on it. Further hits on it deal 30% more damage, and the 5th hit consumes the breakpoint for 200% more damage. A mark nobody hits for 6 seconds wears off. Adds the WHEN target_marked block."
