[gd_resource type="Resource" script_class="SupportGemDefinition" format=3]

[ext_resource type="Script" path="res://systems/skills/support_gem_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/skills/supports/pointer_support.gd" id="2_beh"]
[ext_resource type="Script" path="res://systems/skills/program/skill_knob.gd" id="3_knob"]

[sub_resource type="Resource" id="Knob_seek_range"]
script = ExtResource("3_knob")
id = &"seek_range"
display_name = "Seek range"
kind = 1
flag_key = "pointer_range"
step = 1.0
min_steps = -3
max_steps = 4
cost_per_step = 1.0
unit = "m"

[sub_resource type="Resource" id="Knob_turn_angle"]
script = ExtResource("3_knob")
id = &"turn_angle"
display_name = "Turn"
kind = 1
flag_key = "pointer_turn"
step = 30.0
min_steps = -2
max_steps = 3
cost_per_step = 0.5
unit = "deg"

[resource]
script = ExtResource("1_def")
id = "pointer_support"
display_name = "Pointer Support"
allowed_tags = Array[int]([2])
behavior_script = ExtResource("2_beh")
program_knobs = Array[ExtResource("3_knob")]([SubResource("Knob_seek_range"), SubResource("Knob_turn_angle")])
mana_cost_increase = 0.1
description = "Blast only. Loop repeats aim at the next enemy instead of straight ahead: one within 6 m of where the last shot exploded that the loop hasn't hit yet (up to 90 degrees from where you face), so loops work through a pack. Needs a for or while loop in the script."
