flag_key = "pointer_hops"
step = 1.0
min_steps = -1
max_steps = 3
cost_per_step = 1.5
unit = ""

[resource]
script = ExtResource("1_def")
id = "pointer_support"
display_name = "Pointer Support"
allowed_tags = Array[int]([2])
behavior_script = ExtResource("2_beh")
program_knobs = Array[ExtResource("3_knob")]([SubResource("Knob_hops"), SubResource("Knob_seek_range"), SubResource("Knob_turn_angle")])
mana_cost_increase = 0.1
description = "Blast only. Every explosion follows a pointer to the next enemy: it hops to the nearest enemy within 6 m that it hasn't hit yet and explodes there for 50% of the damage. In a loop, repeats also aim at the next enemy instead of straight ahead, so the loop works through a pack. Script the Hops knob for longer chains."
