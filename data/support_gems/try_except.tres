[resource]
script = ExtResource("1_def")
id = "try_except_support"
display_name = "Try Except Support"
allowed_tags = Array[int]([2])
behavior_script = ExtResource("2_beh")
program_knobs = Array[ExtResource("3_knob")]([SubResource("Knob_stack_damage"), SubResource("Knob_retries"), SubResource("Knob_refund")])
mana_cost_increase = 0.2
description = "Blast only. Misses are caught: a Blast that hits nothing refunds its mana and stores an ERROR (up to 3). Your next Blast that hits handles them all for 25% more damage per error. The cast after a miss also runs the except missed: block. In a loop, a repeat that misses is refunded and tried again."
