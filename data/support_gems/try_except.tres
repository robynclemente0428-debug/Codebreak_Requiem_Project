[resource]
script = ExtResource("1_def")
id = "try_except_support"
display_name = "Try Except Support"
allowed_tags = Array[int]([2])
program_knobs = Array[ExtResource("3_knob")]([SubResource("Knob_retries"), SubResource("Knob_refund")])
mana_cost_increase = 0.2
description = "Blast only. When a loop repeat hits nothing, its mana is refunded, it doesn't count toward the loop cap, and it is tried again from you (once per cast). Adds the except missed: block, whose effects only change that retry."
