[ext_resource type="Script" path="res://systems/skills/program/skill_knob.gd" id="3_knob"]

[sub_resource type="Resource" id="Knob_store_capacity"]
script = ExtResource("3_knob")
id = &"store_capacity"
display_name = "Charge capacity"
kind = 1
flag_key = "var_store_max"
step = 2.0
min_steps = -2
max_steps = 5
cost_per_step = 0.5
unit = ""

[sub_resource type="Resource" id="Knob_store_gain"]
