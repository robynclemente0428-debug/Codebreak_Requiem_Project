[resource]
script = ExtResource("1_def")
id = "rollback_support"
display_name = "Rollback Support"
allowed_tags = Array[int]([0, 1, 2, 3])
program_knobs = Array[ExtResource("3_knob")]([SubResource("Knob_rollback_window"), SubResource("Knob_rollback_cooldown")])
mana_cost_increase = 0.1
description = "Any skill. Keeps a 3-second history of your life. When your life drops below 30%, it is restored to what it was 3 seconds ago, then Rollback needs 20 seconds to recharge. Works while socketed, without casting. Script the window (further back) and the cooldown (shorter) in always: rules."
