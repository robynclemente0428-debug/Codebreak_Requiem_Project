[ext_resource type="Script" path="res://systems/stats/class_trait.gd" id="1_trait"]

[resource]
script = ExtResource("1_trait")
display_name = "Mobility"
description = "15% more damage per 1 movement speed while moving. +0.15 movement speed for every knob step that costs points in your skill programs (drawbacks don't count). Skills start with 2 fewer program points. Phases through enemies: they can't block your path."
extra_points = -2.0
move_speed_per_knob_step = 0.15
moving_damage_more_per_speed = 0.15
phase_through_enemies = true
