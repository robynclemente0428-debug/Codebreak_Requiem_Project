[ext_resource type="Script" path="res://systems/stats/class_trait.gd" id="1_trait"]

[resource]
script = ExtResource("1_trait")
display_name = "Fortified Code"
description = "Each block in your programs gives +10% armour. Each time a WHEN rule fires, +10% armour for 4 seconds. Every 10 armour adds 1 - 1 damage and 1% increased damage."
armour_per_block = 0.1
armour_per_when_fire = 0.1
when_buff_seconds = 4.0
damage_per_10_armour = 0.01
flat_damage_per_10_armour = 1.0
