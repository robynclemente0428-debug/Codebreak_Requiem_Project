[resource]
script = ExtResource("2_quest")
id = "ward_beacons_outer"
title = "WARD BEACONS: OUTER DISTRICTS"
description = "The ward beacons kept the Null out of Hardfault. Now they sit dark in the outer districts.
Reach each beacon and bring it back online. Any order. They are in the room farthest from where you arrive.
REWARD: credits and a support gem of your choice."
objectives = Array[ExtResource("1_obj")]([SubResource("Beacon_0"), SubResource("Beacon_1"), SubResource("Beacon_2")])
prerequisite_quest_ids = Array[String](["tut_basics"])
reward_credits = 150
reward_support_choice = true
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "I"
