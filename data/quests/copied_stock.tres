[resource]
script = ExtResource("2_quest")
id = "copied_stock"
title = "COPIED STOCK"
description = "The copy convoy carried a copy of Hex's stock, and Mirror Husks at Mirror Dock are carrying it about. Hex wants it back, on principle.
Each husk has the DIFF lock, so bring a script with two WHEN rules."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3")])
ordered = false
prerequisite_quest_ids = Array[String](["q05_the_leak"])
reward_credits = 275
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Hex"
metadata/act = "III"
