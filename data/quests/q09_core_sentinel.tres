[resource]
script = ExtResource("2_quest")
id = "q09_core_sentinel"
title = "THE CORE SENTINEL"
description = "The Stack Trace stays shut until Sudo ranks you Defragmenter, so start there.
The Sentinel remembers every enemy you have faced. Past the Stack Trace, where the Core replays them all.
BOSS TRAIT: RECALL. It borrows an old boss's lock for each third of its life: BROOD LINK, then CHECKSUM, then DIFF.
No script task. Use your best build."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_exam"), SubResource("Objective_0"), SubResource("Objective_1")])
ordered = true
prerequisite_quest_ids = Array[String](["q08_null_gatekeeper"])
reward_credits = 300
metadata/giver = "The Last Log"
metadata/act = "V"
