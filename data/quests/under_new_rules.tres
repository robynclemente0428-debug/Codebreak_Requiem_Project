[resource]
script = ExtResource("2_quest")
id = "under_new_rules"
title = "UNDER NEW RULES"
description = "Vesper wants you to stop fighting the Null's laws and start fighting under them. Win under each of its laws, out in the Null Zone. The Rule Forge, off The Deleted Quarter, changes them every 30 seconds."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3")])
ordered = false
prerequisite_quest_ids = Array[String](["q07a_learn_the_language"])
reward_credits = 300
metadata/giver = "Vesper"
metadata/act = "IV"
