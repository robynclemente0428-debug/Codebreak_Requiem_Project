[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("1_obj")
description = "Let Null Echoes copy you"
kind = "echo_copied"
required = 3

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("1_obj")
description = "Crash Null Echoes with a NULL REFERENCE"
kind = "echo_crashed"
required = 6

[resource]
script = ExtResource("2_quest")
id = "under_new_rules"
title = "NULL REFERENCE"
description = "Vesper wants you to stop running from the copies and use them. A Null Echo copies the first skill it sees you cast. Its own lines are a copy, but a  call name()  line is copied as the call: it points at YOUR routines.gd.
Empty a routine an Echo still calls and its call points at nothing: it crashes, and takes a quarter of its life with it.
TIP: a decoy. Give a skill a call to a routine you don't need, cast it first so the Echoes copy it, then empty that routine. The Mirror Forge, off The Deleted Quarter, is full of them."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1")])
ordered = false
prerequisite_quest_ids = Array[String](["q07a_learn_the_language"])
reward_credits = 300
metadata/giver = "Vesper"
metadata/act = "IV"
