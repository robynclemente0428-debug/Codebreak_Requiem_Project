[resource]
script = ExtResource("2_quest")
id = "q02b_the_road_out"
title = "THE ROAD OUT"
description = "Hardfault can't hold out here. It's leaving, and taking everyone with it.
The Null know it too. Cover the evacuation while everyone gets out to the dock, hold the dock while the convoy loads, then get on board and report to Brack."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_2"), SubResource("Objective_1")])
ordered = true
prerequisite_quest_ids = Array[String](["q02_corrupted_gate_guard"])
reward_credits = 100
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "I"
