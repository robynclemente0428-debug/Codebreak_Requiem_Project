[resource]
script = ExtResource("2_quest")
id = "exam_defragmenter"
title = "RANK EXAM: DEFRAGMENTER"
description = "Examiner Sudo's last exam. The Core's memory isn't lost, only out of order, and pieces only fit back in order.
Sit the exam in Sudo's sandbox. Three waves of FRAGMENTED samples: a pack only takes full damage in order, least life left first. The sandbox lends you sorting: registry.sort(key=hp) puts your registry in order, and when target is registry[0]: picks the first in it. Your script must sort the registry and read a place in it, and at least 12 of the 15 fragments must die in order.
Graded PASS, MERIT or DISTINCTION. You can retake it later. Passing makes sorting yours, and opens the Stack Trace: Act V starts here."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0")])
ordered = false
prerequisite_quest_ids = Array[String](["q08_null_gatekeeper"])
reward_credits = 0
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Sudo"
metadata/act = "V"
