[resource]
script = ExtResource("2_quest")
id = "q06b_the_collector"
title = "THE COLLECTOR"
description = "Process C-0, Checkpoint's garbage collector. It deleted the copy, which was the right call. Then it widened its sweep to everything that remembers the copy: Hardfault's records, the Guild logs, and next the yard.
LOCK: GENERATIONS. Three phases, each open only to one script set: A, then B, then C. The wrong set heals it. The lock banner says which it wants.
TIP: build each set for its job. AREA in A for the swarm, big hits in B for the armoured survivors, and something that keeps you alive in C. Kill the adds too: when they pile up it sweeps them, and that heals it."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1")])
ordered = true
prerequisite_quest_ids = Array[String](["q06_the_mimic", "exam_strategist"])
reward_credits = 300
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "III"
