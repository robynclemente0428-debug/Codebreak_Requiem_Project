metadata/_custom_type_script = "uid://bo3sbbxgckkre"

[resource]
script = ExtResource("2_quest")
id = "q04_the_overflow"
title = "THE OVERFLOW"
description = "A giant Stack Crawler is sitting on Hex's power cells out in the Signal Wastes.
LOCK: OVERFLOW. Its buffer holds 5 hits per cast. One cast that lands 6 or more overflows it: the port opens, and everything that cast held lands at once.
TIP: loop a skill all the way to the cap. The repeat that reaches it is the 6th hit, and when stack_overflow: fires right there: make it hit hardest. Then the buffer spills in a ring: step out, or shield up (barrier, guard).
SCRIPT TASK: give a looped skill a when stack_overflow rule."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_1"), SubResource("Objective_2")])
ordered = true
prerequisite_quest_ids = Array[String](["q02_corrupted_gate_guard"])
reward_credits = 200
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Hex"
metadata/act = "II"
