[resource]
script = ExtResource("2_quest")
id = "q00_proximity_trigger"
title = "PROXIMITY TRIGGER"
description = "Brack wants your skill to react before you face the Queen.
SCRIPT TASK: open the skill editor (K > SCRIPTING) and make a skill fire when enemies are near, then use it in a fight."
