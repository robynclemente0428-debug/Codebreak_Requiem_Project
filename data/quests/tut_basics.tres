[gd_resource type="Resource" script_class="QuestDefinition" format=3]

[ext_resource type="Script" uid="uid://bo3sbbxgckkre" path="res://systems/quest/objective.gd" id="1_obj"]
[ext_resource type="Script" uid="uid://ddwasls37yxoi" path="res://systems/quest/quest_definition.gd" id="2_quest"]
[ext_resource type="Script" path="res://systems/quest/tutorial_objective.gd" id="4_tut"]

[sub_resource type="Resource" id="Obj_walk"]
script = ExtResource("1_obj")
description = "Move around (4 steps)"
kind = "walk"
required = 4

[sub_resource type="Resource" id="Obj_map"]
script = ExtResource("1_obj")
description = "Open the full map (TAB)"
kind = "open_panel"
target = "map"

[sub_resource type="Resource" id="Obj_inv"]
script = ExtResource("1_obj")
description = "Open your backpack"
kind = "open_panel"
target = "inventory"

[sub_resource type="Resource" id="Obj_equip"]
script = ExtResource("4_tut")
description = "Equip your weapon"
kind = "equip_slot"
target = "0"

[sub_resource type="Resource" id="Obj_skills"]
script = ExtResource("1_obj")
description = "Open the skill panel"
kind = "open_panel"
target = "skills"

[sub_resource type="Resource" id="Obj_socket"]
script = ExtResource("4_tut")
description = "Socket a skill gem into an empty socket"
kind = "socket_skill"

[sub_resource type="Resource" id="Obj_bind"]
script = ExtResource("4_tut")
description = "Bind the skill to the attack action"
kind = "bind_skill"
target = "attack"

[sub_resource type="Resource" id="Obj_cast"]
script = ExtResource("1_obj")
description = "Use the bound skill 3 times"
kind = "cast"
target = "attack"
required = 3

[resource]
script = ExtResource("2_quest")
id = "tut_basics"
title = "BASIC TRAINING"
description = "Brack's orders: learn to move, gear up, and bind a skill to attack."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_walk"), SubResource("Obj_map"), SubResource("Obj_inv"), SubResource("Obj_equip"), SubResource("Obj_skills"), SubResource("Obj_socket"), SubResource("Obj_bind"), SubResource("Obj_cast")])
ordered = true
reward_credits = 25
reward_support_choice = true
metadata/giver = "Brack"
metadata/act = "I"
