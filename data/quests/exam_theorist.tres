[resource]
script = ExtResource("2_quest")
id = "exam_theorist"
title = "RANK TRIAL: THEORIST"
description = "Floor 10 of The Recursion holds a gate Sudo didn't build: the Theorist trial.
No script check this time. Your own gear, skills and scripts, against five waves that each hit harder than the last. The last is a single champion.
Graded on the lowest life you drop to: MERIT above 40%, DISTINCTION above 70%. Die and it fails; retake it as often as you like.
Report to Examiner Sudo in the Core for the rank."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0")])
ordered = false
prerequisite_quest_ids = Array[String](["exam_defragmenter"])
reward_credits = 0
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Sudo"
