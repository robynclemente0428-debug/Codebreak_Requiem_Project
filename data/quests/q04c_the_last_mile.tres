[resource]
script = ExtResource("2_quest")
id = "q04c_the_last_mile"
title = "THE LAST MILE"
description = "Checkpoint is two stops out, and it answered the relay. Its guns cover the approach.
Hold the deck if anything comes aboard, keep the IFF Transponder answering, then get the convoy through Checkpoint's gate.
LOCK: CHALLENGE. The gate's Perimeter Warden asks who you are, in code. It stops the fight and hands you a challenge program to fix. Solve it and its port opens for a few seconds. Every wrong answer hurts, and so does walking away.
TIP: read the comment at the top of each challenge, then the OUTPUT. The challenges are built on what you already know: crowds, loops, life checks, and steps in order."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_guns"), SubResource("Objective_iff"), SubResource("Objective_gate"), SubResource("Objective_dock"), SubResource("Objective_registrar")])
ordered = true
prerequisite_quest_ids = Array[String](["q04b_hollow_choir"])
reward_credits = 150
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "II"
