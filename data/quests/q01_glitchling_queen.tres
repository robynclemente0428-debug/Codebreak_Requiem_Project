[sub_resource type="Resource" id="Objective_3"]
script = ExtResource("1_obj")
description = "Defeat the Glitchling Queen"
kind = "kill"
target = "glitchling_queen"
metadata/_custom_type_script = "uid://bo3sbbxgckkre"

[resource]
script = ExtResource("2_quest")
id = "q01_glitchling_queen"
title = "THE GLITCHLING QUEEN"
description = "A Queen is breeding Glitchlings near the wall. Her nest is sealed: the Enchanter in the Cache Warrens carries the Brood Key.
BOSS TRAIT: BROOD LINK. Her Glitchlings shield her: while any of them live, your hits do nothing. Kill the whole brood and she is open until the next one hatches.
TIP: clear the swarm first, with an area skill or an enemies_nearby() rule, then turn on the Queen."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_key"), SubResource("Objective_3")])
ordered = true
prerequisite_quest_ids = Array[String](["q00_proximity_trigger"])
reward_credits = 50
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "I"
