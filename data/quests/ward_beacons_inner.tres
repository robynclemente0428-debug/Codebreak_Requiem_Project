[resource]
script = ExtResource("2_quest")
id = "ward_beacons_inner"
title = "WARD BEACONS: INNER DISTRICTS"
description = "The inner beacons guarded the road to the Gate. Light them and the Null loses its grip on the ward.
Reboot each beacon: stand in its ring while it boots, and fight off the Null that come for it. Any order.
REWARD: credits and a support gem of your choice."
objectives = Array[ExtResource("1_obj")]([SubResource("Beacon_0"), SubResource("Beacon_1"), SubResource("Beacon_2"), SubResource("Beacon_3")])
prerequisite_quest_ids = Array[String](["ward_beacons_outer"])
reward_credits = 300
reward_support_choice = true
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "I"
