[resource]
script = ExtResource("2_quest")
id = "guild_expedition"
title = "THE GUILD EXPEDITION"
description = "The Compiler Guild sent an expedition into the Null before Hardfault ever left. Its examiner was Sudo's teacher. Find out what happened at The Expedition's End.
BOSS LOCK: AUDIT. The Auditor only takes hits from a script that earns LEAN or ELEGANT."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3"), SubResource("Objective_4")])
ordered = false
prerequisite_quest_ids = Array[String](["q07a_learn_the_language"])
reward_credits = 350
metadata/giver = "Sudo"
metadata/act = "IV"
