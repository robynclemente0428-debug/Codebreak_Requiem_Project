[resource]
script = ExtResource("2_quest")
id = "q03_loop_hound_alpha"
title = "LOOP HOUND ALPHA"
description = "Alpha leads the pack that blocks our road.
BOSS TRAIT: charges along the same path again and again. Learn the loop, break it.
SCRIPT TASK: give a skill a repeating cycle with every_nth_cast()."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_1"), SubResource("Objective_2")])
ordered = true
prerequisite_quest_ids = Array[String](["q02_corrupted_gate_guard"])
reward_credits = 100
