[resource]
script = ExtResource("2_quest")
id = "q05_the_leak"
title = "THE LEAK"
description = "The copy's memory was never freed. It pooled in the Heap and is eating Checkpoint's archive. Quarantine holds the District Gate shut until you pass Sudo's Strategist exam, so start there.
LOCK: REFCOUNT. It splits into blobs, and it can't be hurt while any are out there. Blobs killed one at a time leak back. Kill three or more within 2 seconds and they stay dead. Refcount 0 opens the port.
TIP: how is up to you. Slam or Blast catch them all at once, Cleave or a chain can sweep them, and a fast enough script can pick them off. Put a big hit in another script set for the core, if you want it faster."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_exam"), SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2")])
ordered = true
prerequisite_quest_ids = Array[String](["q04c_the_last_mile"])
reward_credits = 200
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "III"
