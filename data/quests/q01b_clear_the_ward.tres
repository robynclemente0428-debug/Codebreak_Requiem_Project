[resource]
script = ExtResource("2_quest")
id = "q01b_clear_the_ward"
title = "CLEAR THE WARD"
description = "Half of Hardfault is Null now. Three Corrupted hold the districts between us and the Gate.
Take the ward back, one district at a time."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3")])
prerequisite_quest_ids = Array[String](["q01_glitchling_queen"])
reward_credits = 100
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Brack"
metadata/act = "I"
