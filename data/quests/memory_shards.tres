[resource]
script = ExtResource("2_quest")
id = "memory_shards"
title = "MEMORY SHARDS"
description = "The Leak ate parts of Checkpoint's archive, and they are still lying where it dropped them. Restore a shard by holding its ring until it boots, while the Null come for it.
There's one in each of the Registry, the Heap, Mirror Dock and the Dangling Quarter."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3")])
ordered = false
prerequisite_quest_ids = Array[String](["q04c_the_last_mile"])
reward_credits = 300
reward_support_choice = true
metadata/_custom_type_script = "uid://ddwasls37yxoi"
metadata/giver = "Registrar"
metadata/act = "III"
