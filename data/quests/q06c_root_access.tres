[resource]
script = ExtResource("2_quest")
id = "q06c_root_access"
title = "ROOT ACCESS"
description = "The root key can restore Hardfault's records and open what C-0 kept shut. The Registrar can't touch it, so you'll have to hand it over yourself.
Then say what needs saying. Vesper is out of quarantine. Brack is staying."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3")])
ordered = true
prerequisite_quest_ids = Array[String](["q06b_the_collector"])
reward_credits = 350
