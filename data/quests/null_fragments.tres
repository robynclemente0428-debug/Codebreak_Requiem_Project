[resource]
script = ExtResource("2_quest")
id = "null_fragments"
title = "DECODE THE NULL"
description = "Some Null Weavers in The Fray carry fragments of the Null's language. Vesper wants all five, to read them together."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3"), SubResource("Objective_4")])
ordered = false
prerequisite_quest_ids = Array[String](["q07a_learn_the_language"])
reward_credits = 300
metadata/giver = "Vesper"
metadata/act = "IV"
