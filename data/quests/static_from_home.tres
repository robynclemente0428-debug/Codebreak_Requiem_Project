[resource]
script = ExtResource("2_quest")
id = "static_from_home"
title = "STATIC FROM HOME"
description = "Hardfault keeps calling the relay, and the calls never arrive. Hex traced them to The Echo Wells, where signals fall in and echo forever. Bring back what's left of them."
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2"), SubResource("Objective_3")])
ordered = false
prerequisite_quest_ids = Array[String](["q07_null_weaver_prime"])
reward_credits = 300
metadata/giver = "Hex"
metadata/act = "IV"
