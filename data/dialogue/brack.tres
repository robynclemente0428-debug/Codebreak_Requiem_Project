[gd_resource type="Resource" script_class="DialogueData" format=3 uid="uid://bwqx0at43je0w"]

[ext_resource type="Script" uid="uid://dd85gxidfhqxl" path="res://systems/dialogue/dialogue_data.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
source = "# Warden Brack: leader of Hardfault. Blunt, tired. Gives most boss quests (Acts I to III).
# Lines marked NEW are not in the campaign doc yet.
~ start
@ quest_ready:tut_basics -> ready_tut_basics
@ quest_active:tut_basics -> remind_tut_basics
@ can_start:tut_basics -> offer_tut_basics
@ quest_ready:q00_proximity_trigger -> ready_q00_proximity_trigger
@ quest_active:q00_proximity_trigger -> remind_q00_proximity_trigger
@ can_start:q00_proximity_trigger -> offer_q00_proximity_trigger
@ quest_ready:q06_the_mimic -> ready_q06_the_mimic
@ quest_ready:q05_the_leak -> ready_q05_the_leak
@ quest_ready:q03_loop_hound_alpha -> ready_q03_loop_hound_alpha
@ quest_ready:q02b_the_road_out -> ready_q02b_the_road_out
@ quest_ready:q02_corrupted_gate_guard -> ready_q02_corrupted_gate_guard
@ quest_ready:q01b_clear_the_ward -> ready_q01b_clear_the_ward
@ quest_ready:q01_glitchling_queen -> ready_q01_glitchling_queen
@ quest_ready:ward_beacons_inner -> ready_beacons_inner
@ quest_ready:ward_beacons_outer -> ready_beacons_outer
# The beacon quests are side quests: offered before the reminders, and LATER goes on to them.
@ can_start:ward_beacons_outer -> offer_beacons_outer
@ can_start:ward_beacons_inner -> offer_beacons_inner
-> main

~ main
@ quest_active:q06_the_mimic -> remind_q06_the_mimic
@ quest_active:q05_the_leak -> remind_q05_the_leak
@ quest_active:q03_loop_hound_alpha -> remind_q03_loop_hound_alpha
@ quest_active:q02b_the_road_out -> remind_q02b_the_road_out
@ quest_active:q02_corrupted_gate_guard -> remind_q02_corrupted_gate_guard
@ quest_active:q01b_clear_the_ward -> remind_q01b_clear_the_ward
@ quest_active:q01_glitchling_queen -> remind_q01_glitchling_queen
@ can_start:q01_glitchling_queen -> offer_q01_glitchling_queen
@ can_start:q01b_clear_the_ward -> offer_q01b_clear_the_ward
@ can_start:q02_corrupted_gate_guard -> offer_q02_corrupted_gate_guard
@ can_start:q02b_the_road_out -> offer_q02b_the_road_out
@ can_start:q03_loop_hound_alpha -> offer_q03_loop_hound_alpha
@ can_start:q05_the_leak -> offer_q05_the_leak
@ can_start:q06_the_mimic -> offer_q06_the_mimic
@ quest_active:ward_beacons_inner -> remind_beacons_inner
@ quest_active:ward_beacons_outer -> remind_beacons_outer
-> idle

~ offer_beacons_outer
# NEW: ward beacon side quest
Brack: The ward beacons kept the Null out of Hardfault. The outer ones went dark.
Brack: Spillway, Cache Warrens, Dead Sector. Each one sits deep in its district. Bring them back online.
* ACCEPT -> accept_beacons_outer
* LATER -> main

~ accept_beacons_outer
> start_quest ward_beacons_outer
Brack: Touch a beacon and it starts to reboot. Hold the ring round it until it boots: the Null will come for it. Your map marks them.
-> end

~ remind_beacons_outer
Brack: The outer beacons. Spillway, Cache Warrens, Dead Sector.

~ ready_beacons_outer
Brack: The outer ward is lit again. I saw it from the wall.
* TURN IN -> turnin_beacons_outer
* NOT YET -> end

~ turnin_beacons_outer
> turn_in ward_beacons_outer
Brack: Pick something from the cache. You earned it.
-> start

~ offer_beacons_inner
# NEW: ward beacon side quest, part two
Brack: Four more beacons on the road to the Gate. Relay Trench, Coolant Vaults, the Foundry, the Firewall.
Brack: Light them and the Null loses its grip on the whole ward.
* ACCEPT -> accept_beacons_inner
* LATER -> main

~ accept_beacons_inner
> start_quest ward_beacons_inner
Brack: Same as before. Find them, wake them.
-> end

~ remind_beacons_inner
Brack: The inner beacons. Relay Trench, Coolant Vaults, Foundry, Firewall.

~ ready_beacons_inner
Brack: Every beacon in the ward is burning. First time in a year.
* TURN IN -> turnin_beacons_inner
* NOT YET -> end

~ turnin_beacons_inner
> turn_in ward_beacons_inner
Brack: Take your pick from the cache. Hardfault owes you.
-> start

~ offer_q00_proximity_trigger
Brack: Before you face anything real, teach your skill to think.
Brack: Make it fire when enemies close in. Then prove it works in a fight.
* ACCEPT -> accept_q00_proximity_trigger
* DECLINE -> end

~ accept_q00_proximity_trigger
> start_quest q00_proximity_trigger
Brack: Open your skill editor first. Tell your skill when to fire.
-> end

~ remind_q00_proximity_trigger
Brack: Script your skill, then use it with enemies close.

~ ready_q00_proximity_trigger
Brack: It works?
* TURN IN -> turnin_q00_proximity_trigger
* NOT YET -> end

~ turnin_q00_proximity_trigger
> turn_in q00_proximity_trigger
Brack: Good. Now you're ready for the Queen.
-> start

~ offer_q01_glitchling_queen
Brack: You’re alive. Good. Something woke up in you, and we need it.
Brack: A Queen is breeding Glitchlings near the wall. Kill her.
# NEW line below
Brack: Her nest is sealed. The Enchanter in the Cache Warrens carries the Brood Key.
* ACCEPT -> accept_q01_glitchling_queen
* DECLINE -> end

~ accept_q01_glitchling_queen
> start_quest q01_glitchling_queen
Brack: Your script works. Now use it on her.
-> end

~ remind_q01_glitchling_queen
# NEW line below
Brack: The Queen's still breeding. No Brood Key, no way in. The Enchanter in the Cache Warrens has it.

~ ready_q01_glitchling_queen
Brack: Done?
* TURN IN -> turnin_q01_glitchling_queen
* NOT YET -> end

~ turnin_q01_glitchling_queen
> turn_in q01_glitchling_queen
Brack: Wall’s holding. You’re useful. I’ll admit it.
# NEW lines below: points the player at the Operator exam
Brack: Useful isn't ranked, though. Examiner Sudo wants to see your script.
Brack: Pass the Operator exam in Sudo's sandbox. Nobody goes near the Gate without it.
-> start

~ offer_q01b_clear_the_ward
# Quest 1.3 in the campaign dialogue doc (Clear the Ward), adapted to the ward's districts
Brack: Half our home is Null now. Push it back before it spreads.
Brack: Three Corrupted hold the districts between us and the Gate. Relay Trench, Coolant Vaults, the Foundry.
* ACCEPT -> accept_q01b_clear_the_ward
* DECLINE -> end

~ accept_q01b_clear_the_ward
> start_quest q01b_clear_the_ward
# NEW line below
Brack: One district at a time. Every one you take back, we keep.
-> end

~ remind_q01b_clear_the_ward
# NEW line below
Brack: The ward's still theirs. Relay Trench, Coolant Vaults, Foundry.

~ ready_q01b_clear_the_ward
Brack: Done?
* TURN IN -> turnin_q01b_clear_the_ward
* NOT YET -> end

~ turnin_q01b_clear_the_ward
> turn_in q01b_clear_the_ward
Brack: The ward is ours again. For now.
-> start

~ offer_q02_corrupted_gate_guard
Brack: The Gate Guard went rogue. Nobody gets in or out until it falls.
* ACCEPT -> accept_q02_corrupted_gate_guard
* DECLINE -> end

~ accept_q02_corrupted_gate_guard
> start_quest q02_corrupted_gate_guard
Brack: Sudo will test your scripts first. No test, no rank.
# NEW line below
Brack: Then the Gate Key. The Enchanter at the Firewall Approach carries it.
-> end

~ remind_q02_corrupted_gate_guard
# NEW line below
Brack: Talk to Sudo. Then the Gate Key at the Firewall. Then the Guard.

~ ready_q02_corrupted_gate_guard
Brack: Done?
* TURN IN -> turnin_q02_corrupted_gate_guard
* NOT YET -> end

~ turnin_q02_corrupted_gate_guard
> turn_in q02_corrupted_gate_guard
Brack: The gate is open. Time to move.
-> start

~ offer_q02b_the_road_out
# NEW: the Act I to Act II transition
Brack: We're not holding Hardfault. Not out here, not with the Null this close.
Brack: So we're taking it with us. Every crate, every cell, everyone who can walk.
Brack: A convoy is docked past the Gate. The Null can smell it.
* ACCEPT -> accept_q02b_the_road_out
* NOT YET -> end

~ accept_q02b_the_road_out
> start_quest q02b_the_road_out
Brack: The moment we move, the Null hit the outpost. Hold the portal while everyone gets out to the dock.
Brack: Then hold the dock while we load. Every crate we lose stays here.
Brack: Once it's loaded, you're the last one on board.
-> end

~ remind_q02b_the_road_out
Brack: Hold the portal till everyone's through, then hold the dock till the convoy's loaded. Then get on board.

~ ready_q02b_the_road_out
Brack: You made it aboard.
* TURN IN -> turnin_q02b_the_road_out
* NOT YET -> end

~ turnin_q02b_the_road_out
> turn_in q02b_the_road_out
Brack: Hardfault's behind us. The road isn't.
Brack: Whatever's out there, we meet it moving.
-> start

~ offer_q03_loop_hound_alpha
Brack: Alpha leads the pack that blocks our road. Cut off the head.
* ACCEPT -> accept_q03_loop_hound_alpha
* DECLINE -> end

~ accept_q03_loop_hound_alpha
> start_quest q03_loop_hound_alpha
Brack: Give your skill a stop condition, or you’ll chase it forever.
-> end

~ remind_q03_loop_hound_alpha
# NEW line below
Brack: The road's still blocked. The Alpha holds Scrapline Crossing. Set course from the route terminal.

~ ready_q03_loop_hound_alpha
Brack: Done?
* TURN IN -> turnin_q03_loop_hound_alpha
* NOT YET -> end

~ turnin_q03_loop_hound_alpha
> turn_in q03_loop_hound_alpha
Brack: The hounds scatter without him. Road’s clear.
-> start

~ offer_q05_the_leak
Brack: Something is eating Checkpoint’s memory. It splits every time we hit it.
* ACCEPT -> accept_q05_the_leak
* DECLINE -> end

~ accept_q05_the_leak
> start_quest q05_the_leak
Brack: Hit it hard and hit it wide. A reusable function helps.
-> end

~ remind_q05_the_leak
# NEW line below
Brack: It's still splitting. Hit it wider.

~ ready_q05_the_leak
Brack: Done?
* TURN IN -> turnin_q05_the_leak
* NOT YET -> end

~ turnin_q05_the_leak
> turn_in q05_the_leak
Brack: The leak is sealed. We can finally rest.
-> start

~ offer_q06_the_mimic
Brack: A Null thing is copying everything we do. It copied my voice yesterday.
* ACCEPT -> accept_q06_the_mimic
* DECLINE -> end

~ accept_q06_the_mimic
> start_quest q06_the_mimic
Brack: Vary your pattern. A copied skill is a defeated skill.
-> end

~ remind_q06_the_mimic
# NEW line below
Brack: Change your pattern. It's learning.

~ ready_q06_the_mimic
Brack: Done?
* TURN IN -> turnin_q06_the_mimic
* NOT YET -> end

~ turnin_q06_the_mimic
> turn_in q06_the_mimic
Brack: It’s gone. I never want to hear that voice again.
-> start

~ offer_tut_basics
Brack: Recruit. Before anything else, you learn the basics.
Brack: Move, gear up, and bind a skill to attack. Scripting comes after.
* ACCEPT -> accept_tut_basics
* DECLINE -> end

~ accept_tut_basics
> start_quest tut_basics
Brack: Start by walking around. Your backpack is already on you. Check the quest log for the next step.
-> end

~ remind_tut_basics
Brack: Finish the basics. The quest log has the next step.

~ ready_tut_basics
Brack: Done with the basics?
* TURN IN -> turnin_tut_basics
* NOT YET -> end

~ turnin_tut_basics
> turn_in tut_basics
Brack: Not bad. Take a support gem from the cache, one that suits your skill. Socket it next to your skill.
-> start

~ idle
Brack: Rest while you can."
metadata/_custom_type_script = "uid://dd85gxidfhqxl"
