[sub_resource type="Shader" id="Shader_j5y01"]
code = "shader_type spatial;
// CodeBreak Requiem - Act I town tiles (\"Hardfault\" family, safe-zone version).
// Same outpost steel as the Hardfault dungeon, but kept up by the people living here:
// scrubbed plates, no rust, green SAFE-ZONE guide lights instead of amber hazard stripes,
// warm lit windows in the walls, and a teal walkway trim. `piece`: 0 Floor, 1 Room_Floor, 2 Wall.
render_mode diffuse_burley, specular_schlick_ggx;

uniform int piece = 0;
uniform vec3 steel : source_color = vec3(0.27, 0.28, 0.29);
uniform vec3 dark : source_color = vec3(0.08, 0.085, 0.095);
uniform vec3 paint : source_color = vec3(0.16, 0.24, 0.26);     // painted lower wall band
uniform vec3 deck : source_color = vec3(0.30, 0.27, 0.23);      // warm composite decking
uniform vec3 safe : source_color = vec3(0.25, 1.0, 0.55);       // safe-zone green
uniform vec3 cyan : source_color = vec3(0.0, 0.85, 1.0);
uniform vec3 warm : source_color = vec3(1.0, 0.72, 0.38);       // lived-in window light
uniform float glow = 2.2;

varying vec3 lp;
varying vec3 ln;
varying vec3 tile;      // world position of this tile's centre: one random pick per tile

void vertex() {
	lp = VERTEX;
	ln = NORMAL;
	tile = (MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
}

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
		mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

void fragment() {
	vec3 wp = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec3 an = abs(ln);
	bool top = an.y > 0.5;
	vec2 uv = top ? lp.xz : (an.x > 0.5 ? lp.zy : lp.xy);        // metres, -1..1 across the tile
	vec2 wuv = top ? wp.xz : (an.x > 0.5 ? wp.zy : wp.xy);
	float grime = noise(wuv * 1.3) * 0.7 + noise(wuv * 5.0) * 0.3;   // light wear, no rust

	vec3 col = steel;
	vec3 em = vec3(0.0);
	float metal = 0.45;
	float rough = 0.55;

	if (piece == 0) {
		// Street: solid warm decking planks, teal curb trims, green guide dots down the middle
		if (top) {
			float plank = fract(uv.y * 2.0);
			float gap = step(0.94, plank);
			float tone = hash(vec2(tile.x + tile.z * 3.0, floor(uv.y * 2.0)));
			col = deck * (0.85 + 0.25 * tone);
			col = mix(col, dark, gap);
			float curb = step(0.78, abs(uv.x));
			col = mix(col, steel * 1.1, curb);
			float trim = step(0.80, abs(uv.x)) * (1.0 - step(0.86, abs(uv.x)));
			em += cyan * glow * trim * 0.35;
			col = mix(col, cyan * 0.4, trim);
			// guide dots: one per tile, softly breathing, run along the street
			float dot_d = length(vec2(uv.x, fract(uv.y * 0.5 + 0.25) * 2.0 - 1.0));
			float dotm = 1.0 - smoothstep(0.07, 0.12, dot_d);
			float breathe = 0.7 + 0.3 * sin(TIME * 1.5 - wp.x * 0.4 - wp.z * 0.4);
			em += safe * glow * dotm * breathe * 0.6;
			col = mix(col, safe * 0.4, dotm);
			metal = 0.15;
			rough = 0.7;
		} else {
			col = dark;
		}
	} else if (piece == 1) {
		// Plaza / building floor: clean checker plates with a green safe-zone ring per tile
		if (top) {
			vec2 q = floor(uv + 1.0);                                 // 2x2 sub plates
			float checker = mod(q.x + q.y, 2.0);
			col = mix(steel * 1.15, steel * 0.9, checker);
			vec2 plate = fract(uv + 1.0) * 2.0 - 1.0;
			float seam = step(0.95, max(abs(plate.x), abs(plate.y)));
			col = mix(col, dark, seam * 0.8);
			// thin green ring at the tile's edge: walking on these reads as \"safe\"
			float edge = max(abs(uv.x), abs(uv.y));
			float ring = step(0.9, edge) * (1.0 - step(0.95, edge));
			em += safe * glow * ring * 0.25;
			col = mix(col, safe * 0.35, ring);
			// small warm floor lamp, steady (no flicker: the power here works)
			float lamp = 1.0 - smoothstep(0.06, 0.12, length(uv));
			em += warm * glow * lamp * 0.45;
			col = mix(col, warm * 0.4, lamp);
			metal = 0.4;
			rough = 0.45;
		} else {
			col = dark;
		}
	} else {
		// Building wall: painted lower band, clean upper panels, lit windows, green status strip
		if (top) {
			col = dark * 1.3;
			float rim = step(0.82, max(abs(uv.x), abs(uv.y)));
			col = mix(col, steel, rim);
			float line = step(0.93, max(abs(uv.x), abs(uv.y))) * (1.0 - step(0.96, max(abs(uv.x), abs(uv.y))));
			em += cyan * glow * line * 0.12;
			col = mix(col, cyan * 0.25, line);
		} else {
			float y = uv.y;                                           // -1 bottom .. 1 top of the block
			bool upper = tile.y > 2.0;                                 // second block of a 2-high wall
			float seam = step(0.95, abs(fract(uv.x * 0.5 + 0.5) * 2.0 - 1.0));
			col = upper ? steel : paint;
			col = mix(col, dark, seam);
			col = mix(col, dark, step(y, -0.88));                     // kick plate
			if (upper) {
				// window: warm light behind a frame, some windows dark
				vec2 w = vec2(uv.x, y - 0.05);
				float frame = step(max(abs(w.x) / 0.55, abs(w.y) / 0.42), 1.0);
				float pane = step(max(abs(w.x) / 0.47, abs(w.y) / 0.34), 1.0);
				float mullion = step(abs(w.x), 0.025);
				float lit = step(0.3, hash(tile.xz * 0.37 + vec2(an.x, an.z) * 3.1));   // per tile and side
				col = mix(col, dark * 0.8, frame);
				vec3 glass = mix(dark * 0.6, warm * 0.6, lit);
				col = mix(col, glass, pane * (1.0 - mullion));
				em += warm * glow * pane * (1.0 - mullion) * lit * 0.5;
			} else {
				// green status strip: the outpost's safe-zone boundary
				float strip = step(abs(y - 0.55), 0.045);
				float pulse = 0.8 + 0.2 * sin(TIME * 1.2 + wp.x * 0.5 + wp.z * 0.5);
				em += safe * glow * strip * pulse * 0.6;
				col = mix(col, safe * 0.45, strip);
				// stencilled chevrons above the kick plate
				float chev = step(0.5, fract(uv.x * 2.0 + abs(y + 0.7) * 2.0)) * step(abs(y + 0.7), 0.08);
				col = mix(col, steel * 1.3, chev * 0.6);
			}
			// rivets along the top edge of each block
			vec2 r = vec2(fract(uv.x * 2.0) - 0.5, y - 0.88);
			col = mix(col, steel * 1.6, step(length(r), 0.045));
		}
	}

	col *= 0.92 + 0.08 * grime;
	ALBEDO = col;
	METALLIC = metal;
	ROUGHNESS = rough;
	EMISSION = em;
}
"

