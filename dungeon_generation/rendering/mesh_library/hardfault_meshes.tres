[gd_resource type="MeshLibrary" format=3 uid="uid://bktm4q5140ysj"]

[sub_resource type="Shader" id="Shader_jb42q"]
code = "shader_type spatial;
// CodeBreak Requiem - Act I \"Hardfault\" tiles: rusted outpost steel, amber work lights, cyan system trims.
// One shader for all three pieces; `piece` picks the pattern. Patterns use the tile's own
// coordinates (so every tile matches its neighbours) plus world position (so rust varies).
render_mode diffuse_burley, specular_schlick_ggx;

uniform int piece = 0;                                   // 0 = Floor, 1 = Room_Floor, 2 = Wall
uniform vec3 steel : source_color = vec3(0.20, 0.21, 0.23);
uniform vec3 dark : source_color = vec3(0.06, 0.065, 0.075);
uniform vec3 rust : source_color = vec3(0.34, 0.16, 0.07);
uniform vec3 amber : source_color = vec3(1.0, 0.55, 0.12);
uniform vec3 cyan : source_color = vec3(0.0, 0.9, 1.0);
uniform float glow = 2.5;

varying vec3 lp;
varying vec3 ln;

void vertex() {
	lp = VERTEX;
	ln = NORMAL;
}

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
		mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}
float box(vec2 p, vec2 half_size) { vec2 d = abs(p) - half_size; return max(d.x, d.y); }   // <0 inside

void fragment() {
	vec3 wp = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec3 an = abs(ln);
	bool top = an.y > 0.5;
	vec2 uv = top ? lp.xz : (an.x > 0.5 ? lp.zy : lp.xy);        // metres, -1..1 across the tile
	vec2 wuv = top ? wp.xz : (an.x > 0.5 ? wp.zy : wp.xy);
	float n = noise(wuv * 1.1) * 0.7 + noise(wuv * 4.3) * 0.3;
	float rust_mask = smoothstep(0.66, 0.9, n) * 0.8;

	vec3 col = steel;
	vec3 em = vec3(0.0);
	float metal = 0.65;
	float rough = 0.6;

	if (piece == 0) {
		// Corridor: grate between two solid side rails, a hazard edge and bolts
		if (top) {
			float rail = step(0.62, abs(uv.x));
			float bars = step(0.5, fract(uv.y * 3.0));               // cross bars of the grate
			float slot = (1.0 - rail) * (1.0 - bars);
			col = mix(steel * 1.05, dark * 0.6, slot);                // dark gaps between bars
			col = mix(col, steel * 1.25, rail);
			// hazard stripes on the outer edge of the rails
			float edge = step(0.86, abs(uv.x));
			float stripe = step(0.5, fract((uv.x + uv.y) * 2.5));
			col = mix(col, mix(dark, amber * 0.8, stripe), edge * 0.85);
			// bolts
			vec2 b = abs(uv) - vec2(0.74, 0.78);
			col = mix(col, steel * 1.6, step(length(b), 0.06));
		} else {
			col = dark;
		}
	} else if (piece == 1) {
		// Room floor: big plates with seams, a bolt per corner and a faint amber center light
		if (top) {
			vec2 cell = fract(uv * 0.5 + 0.5) * 2.0 - 1.0;           // whole tile = one plate
			float seam = step(0.9, max(abs(cell.x), abs(cell.y)));
			vec2 plate = fract(uv + 1.0) * 2.0 - 1.0;               // 4 sub plates per tile
			float sub = step(0.95, max(abs(plate.x), abs(plate.y)));
			col = mix(steel * 1.15, steel * 0.85, step(0.5, hash(floor(wuv))));   // plate tint varies
			col = mix(col, dark, max(seam, sub * 0.6));
			vec2 bc = abs(plate) - vec2(0.75);
			col = mix(col, steel * 1.7, step(length(bc), 0.07));
			// light in the middle of every tile, flickering on a few
			float lamp = 1.0 - smoothstep(0.08, 0.16, length(uv));
			float flick = step(0.15, hash(floor(wuv * 0.5)) ) * (0.7 + 0.3 * sin(TIME * 3.0 + hash(floor(wuv)) * 20.0));
			em += amber * glow * lamp * flick * 0.6;
			col = mix(col, amber * 0.4, lamp);
			metal = 0.5;
		} else {
			col = dark;
		}
	} else {
		// Wall block: riveted panels, a cyan system strip, rust streaks, dark cap with amber rim on top
		if (top) {
			// dark cap with a steel rim; a dim orange line runs along the rim
			float m = max(abs(uv.x), abs(uv.y));
			col = dark * 1.4 + noise(wuv * 3.0) * 0.03;
			col = mix(col, steel * 0.75, step(0.86, m));
			float line = step(0.9, m) * (1.0 - step(0.93, m));
			em += amber * glow * line * 0.12;
			col = mix(col, amber * 0.35, line * 0.6);
			metal = 0.4;
		} else {
			float y = uv.y;                                           // -1 bottom .. 1 top of the block
			float h = fract((wp.y) * 0.5);                             // 0..1 per block, blocks stack
			float panel = step(0.94, abs(fract(uv.x * 0.5 + 0.5) * 2.0 - 1.0));   // vertical seam
			col = mix(steel, dark, panel);
			float rib = step(abs(y + 0.45), 0.07);                    // horizontal ribs
			col = mix(col, steel * 1.35, rib);
			float base = step(y, -0.85);
			col = mix(col, dark, base);
			// cyan system strip on the upper block, amber caution strip on the lower block
			float strip = step(abs(y - 0.55), 0.05);
			float upper = step(0.5, fract(wp.y * 0.25));
			vec3 sc = mix(amber, cyan, upper);
			float pulse = 0.75 + 0.25 * sin(TIME * 2.0 + wp.x * 0.7 + wp.z * 0.7);
			em += sc * glow * strip * pulse * 0.8;
			col = mix(col, sc * 0.5, strip);
			// rust streaks running down from the rib
			float streak = smoothstep(0.62, 0.9, noise(vec2(wuv.x * 6.0, wuv.y * 0.6))) * step(y, 0.4);
			col = mix(col, rust, max(rust_mask * 0.5, streak * 0.7));
			// rivets
			vec2 r = vec2(fract(uv.x * 2.0) - 0.5, y - 0.85);
			col = mix(col, steel * 1.6, step(length(r * vec2(1.0, 1.0)), 0.05));
		}
	}

	col = mix(col, rust, rust_mask * (piece == 2 ? 0.0 : 0.35));
	ALBEDO = col;
	METALLIC = metal;
	ROUGHNESS = mix(rough, 0.9, rust_mask);
	EMISSION = em;
}
"

