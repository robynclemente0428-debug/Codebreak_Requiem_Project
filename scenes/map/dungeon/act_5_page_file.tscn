[node name="PageFile" type="Node3D"]
metadata/_note = "PROTOTYPE. Act V, level 46, the third floor down (after Sentinel's Hall, before The Scheduler): where the Core sends what it can't hold. Every enemy is PAGED (PagedLock): out of memory now and then unless one of your registries references it. The Watchdog (HEARTBEAT) holds the far room. kernel.gd runs here."
script = ExtResource("1_dun")
dungeon_level = 46
respawn_spawn_id = &"pagefile_in"
portal_scene = ExtResource("2_portal")
metadata/_custom_type_script = "uid://bcsya5wc4u6ie"

[node name="DungeonDirector" type="Node" parent="." node_paths=PackedStringArray("grid_map", "layout_root")]
script = ExtResource("3_dir")
grid_width = 100
grid_height = 100
corridor_width = 2
min_room_size = 6
max_room_size = 9
room_interval = 8
num_branch_rooms = 2
grid_map = NodePath("../NavigationRegion3D/GridMap")
dungeon_theme = ExtResource("4_theme")
layout_root = NodePath("../Layout")
loop_connections = 0
straight_corridors = true
filler_rooms = true
random_rooms = 5
random_room_spread = 12
metadata/_custom_type_script = "uid://b5gwgfu4bdnrx"

