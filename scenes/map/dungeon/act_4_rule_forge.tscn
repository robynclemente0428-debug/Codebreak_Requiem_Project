[node name="RuleForge" type="Node3D"]
metadata/_note = "PROTOTYPE. Act IV challenge zone, level 33, off The Deleted Quarter: where the Null tries its laws out. They change every 30 seconds instead of 80, Reflector is always on (plus one random threat), and far more rares and champions spawn, so it drops better. A champion Null Weaver holds the last room. Both portals lead back to The Deleted Quarter."
script = ExtResource("1_dun")
dungeon_level = 33
respawn_spawn_id = &"forge_in"
portal_scene = ExtResource("2_portal")
metadata/_custom_type_script = "uid://bcsya5wc4u6ie"

